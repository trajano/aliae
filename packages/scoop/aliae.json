{
  "version": "<VERSION>",
  "description": "Cross platform shell management",
  "homepage": "<DOCS_URL>",
  "license": {
    "identifier": "MIT",
    "url": "https://github.com/<REPO>/blob/master/LICENSE"
  },
  "architecture": {
    "64bit": {
      "url": "https://github.com/<REPO>/releases/download/v<VERSION>/aliae-windows-amd64.exe",
      "hash": "<HASH-AMD64>",
      "bin": [
        [
          "aliae-windows-amd64.exe",
          "aliae"
        ]
      ]
    },
    "32bit": {
      "url": "https://github.com/<REPO>/releases/download/v<VERSION>/aliae-windows-386.exe",
      "hash": "<HASH-386>",
      "bin": [
        [
          "aliae-windows-386.exe",
          "aliae"
        ]
      ]
    },
    "arm64": {
      "url": "https://github.com/<REPO>/releases/download/v<VERSION>/aliae-windows-arm64.exe",
      "hash": "<HASH-ARM64>",
      "bin": [
        [
          "aliae-windows-arm64.exe",
          "aliae"
        ]
      ]
    }
  },
  "checkver": {
    "github": "https://github.com/<REPO>"
  },
  "post_install": [
    "Write-Host 'Thanks for installing aliae.'",
    "Write-Host 'Have a look at <DOCS_URL> for detailed instructions for your shell.'"
  ],
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/<REPO>/releases/download/v<VERSION>/aliae-windows-amd64.exe"
      },
      "32bit": {
        "url": "https://github.com/<REPO>/releases/download/v<VERSION>/aliae-windows-386.exe"
      },
      "arm64": {
        "url": "https://github.com/<REPO>/releases/download/v<VERSION>/aliae-windows-arm64.exe"
      }
    },
    "hash": {
      "url": "$url.sha256"
    }
  }
}
